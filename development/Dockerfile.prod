# ----------------------------------------------------------------------------
# Stage 1: Builder for Development, Linting, and Testing
# ----------------------------------------------------------------------------
  FROM python:3.12.4-slim-bookworm AS builder

  # Set working directory
  WORKDIR /usr/src/app

  # Set environment variables
  ENV PYTHONDONTWRITEBYTECODE=1
  ENV PYTHONUNBUFFERED=1

  # Install system dependencies
  RUN apt-get update \
      && apt-get -y install gcc postgresql \
      && apt-get clean

  # Install pip dependencies
  COPY ./app/requirements-dev.txt ./requirements.txt
  RUN pip install --no-cache-dir -r ./requirements.txt

  # Copy application code
  COPY ./app .

  # Build-time linting and testing (allow failures without stopping the build)
  RUN pytest -p no:warnings --cov=. || echo "Tests failed during build phase"
  RUN black . --check --exclude=migrations || echo "Linting failed during build phase"
  RUN ruff check . --fix --exclude 'tests/*,movies/migrations/*,tasks.py,drf_project/settings.py' || echo "Ruff checks failed during build phase"

  # ----------------------------------------------------------------------------
  # Stage 2: Production Image
  # ----------------------------------------------------------------------------
  FROM python:3.12.4-slim-bookworm AS production

  # Set working directory
  WORKDIR /usr/src/app

  # Set environment variables
  ENV PYTHONDONTWRITEBYTECODE=1
  ENV PYTHONUNBUFFERED=1
  ENV DEBUG=0
  ENV DJANGO_ALLOWED_HOSTS=.herokuapp.com

  # Install system dependencies
  RUN apt-get update \
      && apt-get -y install gcc postgresql \
      && apt-get clean

  # Copy only production requirements and install them
  COPY ./app/requirements.txt .
  RUN pip install --no-cache-dir -r ./requirements.txt

  # Copy the application code from the builder
  COPY --from=builder /usr/src/app .

  # Collect static files
  RUN python manage.py collectstatic --noinput

  # Create a non-root user and switch to it
  RUN adduser --disabled-password myuser
  USER myuser

  # Expose port 8000
  EXPOSE 8000

  # Set the entrypoint or command to run the application
  CMD ["gunicorn", "drf_project.wsgi:application", "--bind", "0.0.0.0:8000"]
